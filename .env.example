# Firebase Console > Project settings > Your apps > Web app se ye values copy karein
# Is file ko copy kar ke ".env" naam se save karein aur values bhar dein
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Photo / video upload ke liye (Cloudinary, free). README.md ka step 6 dekhein
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
