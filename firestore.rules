rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin email (wahi jo Firebase Authentication mein banayi hai)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['muneeburrehmana6@gmail.com'];
    }

    // Order sahi shakal mein aaya hai ya nahi (customer sirf naya order bana sakta hai)
    function validOrder(orderId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['orderNo','items','subtotal','deliveryFee','total','customer','paymentMethod','paymentStatus','status','createdAt'])
        && d.orderNo == orderId
        && d.status == 'received'
        && d.paymentStatus == 'pending'
        && d.createdAt == request.time
        && d.items is list && d.items.size() > 0 && d.items.size() <= 40
        && d.total is number && d.total > 0 && d.total < 200000
        && d.subtotal is number && d.deliveryFee is number
        && d.paymentMethod in ['cod','easypaisa','jazzcash','bank']
        && d.customer.keys().hasOnly(['name','phone','address','notes'])
        && d.customer.name is string && d.customer.name.size() < 100
        && d.customer.phone is string && d.customer.phone.size() < 20
        && d.customer.address is string && d.customer.address.size() < 400
        && d.customer.notes is string && d.customer.notes.size() < 500;
    }

    // Menu: sab dekh sakte hain, sirf admin badal sakta hai
    match /menu/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Aaj ki offers (poster / video): sab dekh sakte hain, sirf admin badal sakta hai
    match /promos/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Website settings (upar wali patti): sab dekh sakte hain, sirf admin badal sakta hai
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: customer apna order number se dekh sakta hai, poori list sirf admin dekh sakta hai
    match /orders/{orderId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if validOrder(orderId);
      allow update, delete: if isAdmin();
    }
  }
}